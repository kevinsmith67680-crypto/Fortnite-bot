{
  "database": {
    "path": "data/chest_locations.db"
  },
  "simulation": {
    "default_map": "research_arena_01",
    "default_spawn_probability": 0.8,
    "default_open_seconds": 2.0,
    "map_width": 100,
    "map_height": 100,
    "cell_size": 8,
    "world_units_per_cell": 10.0,
    "tick_rate": 30,
    "render_rate": 15,
    "default_seed": 42,
    "max_ticks": 100000,
    "player_speed": 5.0,
    "player_acceleration": 12.0,
    "player_radius": 0.3,
    "agent_start": null,
    "interaction_radius": 1.5,
    "chest_interaction_seconds": 2.0,
    "interaction_failure_probability": 0.0,
    "reward_probability": 0.0,
    "obstacle_density": 0.12,
    "decoration_density": 0.004
  },
  "navigation": {
    "allow_diagonal": true,
    "prevent_corner_cutting": true,
    "cache_paths": true,
    "default_strategy": "weighted",
    "stuck_timeout_seconds": 5.0,
    "smooth_paths": true,
    "lookahead_depth": 2
  },
  "agent": {
    "max_recovery_attempts": 3,
    "arrival_tolerance": 0.5,
    "observation_batch_size": 10
  },
  "vision": {
    "enabled": true,
    "default_width": 640,
    "default_height": 360,
    "view_width_cells": 40,
    "detector": "hybrid",
    "confidence_threshold": 0.85,
    "max_tracks": 100,
    "track_expiration_seconds": 3.0,
    "track_memory_seconds": 600.0,
    "use_regions_of_interest": true,
    "noise_std": 6.0,
    "lighting_variation": 0.08,
    "frame_dropout": 0.0,
    "rate_travel": 2.0,
    "rate_explore": 5.0,
    "rate_tracking": 10.0,
    "rate_verify": 10.0,
    "rate_idle": 1.0,
    "template_dir": "assets/templates"
  },
  "localization": {
    "smoothing_alpha": 0.4,
    "max_missing_observations": 5,
    "min_confidence": 0.5,
    "dead_reckoning_seconds": 2.0
  },
  "visual_navigation": {
    "exploration_strategy": "frontier",
    "replan_on_obstacle_discovery": true,
    "maximum_recovery_attempts": 3,
    "use_spawn_priors": true,
    "prior_weight": 300.0,
    "stop_when_spawn_points_resolved": true,
    "unknown_cell_cost": 0.5,
    "empty_confirmations": 2
  },
  "visual_debug": {
    "enabled": true,
    "show_detections": true,
    "show_object_tracks": true,
    "show_occupancy_grid": false,
    "show_localization": true,
    "show_camera_view": true
  },
  "logging": {
    "level": "INFO"
  }
}
